{
  "name": "downly",
  "productName": "Downly",
  "version": "1.0.3",
  "description": "Fast download manager with browser integration, video/audio grabbing and playlists",
  "main": "./out/main/index.js",
  "author": {
    "name": "Mohamed Adel",
    "email": "92869559+mo7ammed3adel@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "python scripts/make-icons.py",
    "dist:win": "node scripts/dist.mjs win",
    "dist:win7": "node scripts/dist.mjs win7",
    "dist:store": "node scripts/dist.mjs store",
    "dist:mac": "node scripts/dist.mjs mac",
    "dist:linux": "node scripts/dist.mjs linux",
    "extension:zip": "node scripts/pack-extension.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "zustand": "^5.0.5"
  },
  "build": {
    "appId": "com.downly.app",
    "productName": "Downly",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "icon.png",
          "tray.png",
          "downly-firefox.xpi"
        ]
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Downly-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "createDesktopShortcut": true
    },
    "appx": {
      "applicationId": "Downly",
      "displayName": "Downly",
      "backgroundColor": "transparent",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "en-US",
        "ar-EG"
      ],
      "artifactName": "Downly-Store.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "resources/icon.png",
      "artifactName": "Downly-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "resources/icon.png",
      "artifactName": "Downly-linux.${ext}",
      "maintainer": "Mohamed Adel <92869559+mo7ammed3adel@users.noreply.github.com>",
      "synopsis": "Fast free download manager"
    },
    "publish": {
      "provider": "github",
      "owner": "mo7ammed3adel",
      "repo": "downly-releases"
    }
  },
  "homepage": "https://downly-app.vercel.app"
}
